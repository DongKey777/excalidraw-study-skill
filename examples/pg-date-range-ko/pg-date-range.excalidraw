      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "CREATE INDEX orders_created_kst_date_idx ON orders\n  (((created_at AT TIME ZONE 'Asia/Seoul')::date));\n\nWHERE (created_at AT TIME ZONE 'Asia/Seoul')::date = '2026-07-01'",
      "originalText": "CREATE INDEX orders_created_kst_date_idx ON orders\n  (((created_at AT TIME ZONE 'Asia/Seoul')::date));\n\nWHERE (created_at AT TIME ZONE 'Asia/Seoul')::date = '2026-07-01'",

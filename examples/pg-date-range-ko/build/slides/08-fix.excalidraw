    {
      "type": "text",
      "x": 5434,
      "y": 1328.95,
      "width": 1412,
      "height": 171,
      "fontSize": 14,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.35,
      "autoResize": false,
      "strokeColor": "#FFFFFF",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "text": "EXPLAIN (ANALYZE, BUFFERS, COSTS OFF)\nSELECT sum(amount) FROM orders\nWHERE created_at >= '2026-07-01 00:00:00+09' AND created_at < '2026-07-02 00:00:00+09';\n…\n  ->  Index Scan using orders_created_at_idx on orders (actual time=0.051..0.773 rows=9600.00 loops=1)\n        Index Cond: ((created_at >= '2026-07-01 00:00:00+09'::timestamp with time zone) AND (created_at < '2026-07-02 00:00:00+09'::timestamp with time zone))\n        Index Searches: 1\n        Buffers: shared hit=72 read=30\n…",
      "originalText": "EXPLAIN (ANALYZE, BUFFERS, COSTS OFF)\nSELECT sum(amount) FROM orders\nWHERE created_at >= '2026-07-01 00:00:00+09' AND created_at < '2026-07-02 00:00:00+09';\n…\n  ->  Index Scan using orders_created_at_idx on orders (actual time=0.051..0.773 rows=9600.00 loops=1)\n        Index Cond: ((created_at >= '2026-07-01 00:00:00+09'::timestamp with time zone) AND (created_at < '2026-07-02 00:00:00+09'::timestamp with time zone))\n        Index Searches: 1\n        Buffers: shared hit=72 read=30\n…",
      "id": "fix-027-code",
      "version": 1,
      "versionNonce": 2111217685,
      "isDeleted": false,
